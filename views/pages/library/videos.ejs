<%- include('../../partials/head') %>
<div class="viewer-shell">
  <%- include('../../partials/aside') %>

  <div class="viewer-content">
    <%- include('../../partials/header') %>

    <main class="viewer-main">
      <a class="viewer-back" href="/auth/library/<%= library.slug %>">← Retornar ao catálogo</a>
      <section class="viewer-head">
        <div class="viewer-cover video">
          <span class="viewer-type-badge" aria-hidden="true">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <rect x="3" y="5" width="18" height="14" rx="2" />
              <path d="m10 9 5 3-5 3Z" />
            </svg>
          </span>
        </div>
        <div>
          <span class="category-badge <%= library.category.toLowerCase() %>" title="Videos" aria-label="Videos">
            <%= library.category %>
          </span>
          <h1><%= library.item.title %></h1>
          <p><%= library.item.description %></p>
        </div>
      </section>
      <div class="viewer-layout">
        <section class="viewer-card">
          <h2>Informações do item</h2>
          <div class="field-grid">
            <div class="field"><label>Autor</label><span><%= library.item.author %></span></div>
            <div class="field"><label>Lançamento</label><span><%= library.item.releaseDate %></span></div>
            <div class="field"><label>Duração</label><span><%= library.item.duration %></span></div>
            <div class="field"><label>Plataforma</label><span><%= library.item.platform %></span></div>
            <div class="field"><label>Tags</label>
              <div class="tags">
                <% library.item.tags.forEach(tag => { %>
                <b><%= tag %></b>
                <% }) %>
              </div>
            </div>
            <div class="field"><label>Idioma</label><span><%= library.item.language %></span></div>
            <div class="field"><label>URL externa</label><span><a href="<%= library.item.externalUrl %>"><%= library.item.externalUrl %></a></span></div>
          </div>
        </section>
        <aside class="viewer-card">
          <h2>Visualização JSON</h2>
          <pre class="json-preview">{
  "title": "",
  "description": "",
  "releaseDate": "",
  "duration": "",
  "tags": [],
  "externalUrl": "",
  "platform": "",
  "language": "",
  "author": "",
  "thumbnail": ""
}</pre>
        </aside>
      </div>
    </main>
  </div>
  <div class="mobile-overlay" id="overlay"></div>
</div>
<%- include('../../partials/footer') %>