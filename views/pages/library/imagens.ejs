<%- include('../../partials/head') %>
<div class="viewer-shell">
  <%- include('../../partials/aside') %>

  <div class="viewer-content">
    <%- include('../../partials/header') %>

    <main class="viewer-main">
      <a class="viewer-back" href="/auth/library/<%= library.slug %>">← Retornar ao catálogo</a>
      <section class="viewer-head">
        <div class="viewer-cover other">
          <span class="viewer-type-badge" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" role="img" aria-label="Imagem">
              <rect x="3" y="4" width="18" height="16" rx="3" fill="none" stroke="currentColor" stroke-width="1.8" />
              <circle cx="8" cy="9" r="1.7" fill="currentColor" />
              <path d="m4.5 18 5.3-5.4 3.4 3.2 2.4-2.4 4.9 4.6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
        </div>
        <div>
          <span class="category-badge <%= library.category.toLowerCase() %>" title="Livros" aria-label="Livros">
            <%= library.category %>
          </span>
          <h1><%= library.item.title %></h1>
          <p><%= library.item.description %></p>
        </div>
      </section>
      <div class="viewer-layout">
        <section class="viewer-card">
          <h2>Informações do item</h2>
          <div class="field-grid">
            <div class="field"><label>Data de adição</label><span><%= library.item.releaseDate %></span></div>
            <div class="field"><label>Formato</label><span><%= library.item.platform %></span></div>
            <div class="field"><label>Tags</label>
              <div class="tags"><% library.item.tags.forEach(tag => { %> <b><%= tag %></b> <% }) %></div>
            </div>
            <div class="field"><label>URL externa</label><span><a href="<%= library.item.externalUrl %>"><%= library.item.externalUrl %></a></span></div>
          </div>
        </section>
        <aside class="viewer-card">
          <h2>Visualização JSON</h2>
          <pre class="json-preview">{
  "title": "",
  "description": "",
  "releaseDate": "",
  "tags": [],
  "platform": "",
  "externalUrl": ""
}</pre>
        </aside>
      </div>
    </main>
  </div>
  <div class="mobile-overlay" id="overlay"></div>
</div>
