<%- include('../partials/head') %>
<main class="auth-page">
  <section class="auth-card"><button class="auth-theme" id="themeToggle" type="button" aria-label="Alternar tema">◐</button><a class="auth-brand" href="index.html"><img src="/assets/images/logo.svg" alt="JSONLibrary"></a>
    <h1>Boas-vindas de volta</h1>
    <p class="auth-intro">Entre para continuar organizando suas bibliotecas.</p>
    <form class="auth-form" action="/login/auth" method="post">
      <label>E-mail<input name="email" type="email" placeholder="voce@exemplo.com" required>
      </label>
      <label>Senha
        <span class="password-field">
          <input name="password" type="password" placeholder="Sua senha" required>
          <button class="toggle-password" type="button" aria-label="Mostrar senha" aria-pressed="false">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z" />
              <circle cx="12" cy="12" r="2.5" />
            </svg>
          </button>
        </span>
      </label>
      <div class="auth-row"><label class="auth-check">
          <input name="remember" type="checkbox">Manter conectado
        </label>
        <a class="auth-link" href="#">Esqueci minha senha</a>
      </div>
      <label class="auth-check">
        <input name="termsOfUseAndPrivacy" type="checkbox" required>
        Li e aceito os <a href="/terms/">termos de uso</a> e a <a href="/terms/">política de privacidade</a>.
      </label>
      <button class="primary auth-submit" type="submit">Entrar</button>
    </form>
    <p class="auth-footer">Ainda não possui uma conta? <a class="auth-link" href="/register">Criar conta</a></p>
  </section>
</main>
<%- include('../partials/footer') %>